# SOC Home Lab - Wazuh stack credentials
# Copy to .env (git-ignored). These are the wazuh-docker defaults, which match
# the bcrypt hashes in config/wazuh_indexer/internal_users.yml and the API
# password in config/wazuh_dashboard/wazuh.yml. Rotating them means updating
# those files too: see "Rotating Wazuh credentials" in docs/setup-guide.md.
INDEXER_PASSWORD=SecretPassword
DASHBOARD_PASSWORD=kibanaserver
API_PASSWORD=MyS3cr37P450r.*-

# SOAR engine. SOAR_SHARED_SECRET must equal <api_key> of the custom-soar
# integration in ossec.conf; generate one with: openssl rand -hex 32
SOAR_SHARED_SECRET=CHANGE_ME_SOAR_SHARED_SECRET
ABUSEIPDB_API_KEY=
SLACK_WEBHOOK_URL=
