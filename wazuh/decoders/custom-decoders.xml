<!--
  SOC Home Lab - Custom Log Decoders
  Author: Omar Alraas
  Description: Decoders for non-standard log sources in the lab
-->

<!-- Custom Application Log Decoder -->
<decoder name="custom-app">
  <prematch>^APP\[\d+\]:</prematch>
</decoder>

<decoder name="custom-app-fields">
  <parent>custom-app</parent>
  <regex>^APP\[(\d+)\]: (\S+) (\S+) src=(\S+) user=(\S+) action=(\S+) status=(\S+)</regex>
  <order>id,severity,module,srcip,user,action,status</order>
</decoder>

<!-- Honeypot Log Decoder -->
<decoder name="honeypot">
  <prematch>^HONEYPOT:</prematch>
</decoder>

<decoder name="honeypot-fields">
  <parent>honeypot</parent>
  <regex>^HONEYPOT: type=(\S+) src=(\S+):(\d+) dst=(\S+):(\d+) proto=(\S+)</regex>
  <order>service,srcip,srcport,dstip,dstport,protocol</order>
</decoder>

<!-- Custom WAF Log Decoder -->
<decoder name="custom-waf">
  <prematch>^WAF\|</prematch>
</decoder>

<decoder name="custom-waf-fields">
  <parent>custom-waf</parent>
  <regex>^WAF\|(\S+)\|(\S+)\|(\d+)\|(\S+)\|(\S+)\|rule_id=(\d+)\|score=(\d+)</regex>
  <order>timestamp,srcip,srcport,method,url,rule_id,anomaly_score</order>
</decoder>

<!-- Suricata EVE JSON Decoder -->
<decoder name="suricata-eve">
  <prematch>^{"timestamp":</prematch>
  <plugin_decoder>JSON_Decoder</plugin_decoder>
</decoder>
