# =============================================================================
# SOC Home Lab - Custom Threat Detection Rules (Suricata 8)
# Author: Omar Alraas
# SID range: 1000001-1000019
# Tests: tests/suricata (each SID is replayed against generated PCAPs)
#
# Real beacon detection (regular intervals + low jitter) needs statistics
# across many flows; that lives in scripts/threat-hunting/beacon_hunter.py.
# =============================================================================

# --- Command and control -----------------------------------------------------

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB High-frequency HTTP POSTs to one external host"; flow:established,to_server; http.method; content:"POST"; threshold:type both,track by_src,count 10,seconds 600; classtype:trojan-activity; sid:1000001; rev:2; metadata:mitre_technique_id T1071.001;)

alert tls $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-LAB TLS certificate with OpenSSL default subject (self-signed tooling)"; flow:established,to_client; tls.cert_subject; content:"O=Internet Widgits Pty Ltd"; classtype:policy-violation; sid:1000004; rev:2; metadata:mitre_technique_id T1573.002;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB curl or wget User-Agent from an internal host"; flow:established,to_server; http.user_agent; pcre:"/^(curl|wget)\//i"; classtype:policy-violation; sid:1000005; rev:2; metadata:mitre_technique_id T1105;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB Python HTTP library User-Agent from an internal host"; flow:established,to_server; http.user_agent; content:"python-"; startswith; classtype:policy-violation; sid:1000006; rev:2; metadata:mitre_technique_id T1071.001;)

# --- DNS tunnelling / exfiltration --------------------------------------------

alert dns $HOME_NET any -> any any (msg:"SOC-LAB DNS query with an oversized encoded label"; dns.query; bsize:>50; pcre:"/^[A-Za-z0-9-]{45,63}\./"; classtype:bad-unknown; sid:1000002; rev:2; metadata:mitre_technique_id T1071.004;)

alert dns $HOME_NET any -> any any (msg:"SOC-LAB High rate of DNS queries from one host"; dns.opcode:0; threshold:type both,track by_src,count 100,seconds 60; classtype:bad-unknown; sid:1000003; rev:2; metadata:mitre_technique_id T1071.004;)

alert dns $HOME_NET any -> any any (msg:"SOC-LAB DNS TXT query with a long encoded label (C2 / exfil channel)"; dns.rrtype:16; dns.query; bsize:>40; pcre:"/^[A-Za-z0-9-]{30,63}\./"; classtype:bad-unknown; sid:1000009; rev:2; metadata:mitre_technique_id T1048.003;)

# --- Resource hijacking -------------------------------------------------------

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB Stratum mining protocol (mining.subscribe)"; flow:established,to_server; content:"\"method\""; content:"mining.subscribe"; distance:0; classtype:policy-violation; sid:1000007; rev:2; metadata:mitre_technique_id T1496.001;)

alert dns $HOME_NET any -> any any (msg:"SOC-LAB DNS lookup for a cryptocurrency mining pool"; dns.query; pcre:"/(^|\.)(supportxmr|nanopool|minexmr|2miners|f2pool|nicehash|moneroocean|hashvault)\./i"; classtype:policy-violation; sid:1000008; rev:2; metadata:mitre_technique_id T1496.001;)

# --- Reconnaissance / initial access -----------------------------------------

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-LAB Possible TCP port scan (SYN burst)"; flow:stateless; flags:S,12; threshold:type both,track by_src,count 25,seconds 10; classtype:attempted-recon; sid:1000010; rev:2; metadata:mitre_technique_id T1046;)

alert tcp any any -> $HOME_NET any (msg:"SOC-LAB TCP SYN+FIN scan"; flow:stateless; flags:SF,12; classtype:attempted-recon; sid:1000011; rev:2; metadata:mitre_technique_id T1046;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS (msg:"SOC-LAB SQL injection pattern in HTTP URI"; flow:established,to_server; http.uri; pcre:"/(union(\s|\+|\/\*.*?\*\/)+(all(\s|\+)+)?select|['\x22]\s*or\s+['\x22]?\d+['\x22]?\s*=\s*['\x22]?\d+|\x3b\s*drop\s+table|sleep\(\d+\)|benchmark\()/i"; classtype:web-application-attack; sid:1000012; rev:2; metadata:mitre_technique_id T1190;)

# --- Policy -------------------------------------------------------------------
# Connection-count rules match the SYN: thresholds count matching *packets*,
# so matching established traffic would count one chatty session as many.

alert tcp $HOME_NET any -> $EXTERNAL_NET ![21,22,23,25,53,80,123,443,587,993,995] (msg:"SOC-LAB Repeated outbound connections on a non-standard port"; flags:S,12; threshold:type both,track by_src,count 5,seconds 300; classtype:policy-violation; sid:1000013; rev:3; metadata:mitre_technique_id T1571;)
