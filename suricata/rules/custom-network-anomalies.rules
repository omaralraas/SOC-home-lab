# =============================================================================
# SOC Home Lab - Network Anomaly Rules (Suricata 8)
# Author: Omar Alraas
# SID range: 1000020-1000039
# Tests: tests/suricata
#
# ARP spoofing is deliberately absent: Suricata has no ARP rule protocol
# (the previous "alert arp" rule made the whole file fail to load). Use
# arpwatch or Zeek for layer-2 monitoring.
# =============================================================================

# --- Tunnelling over ICMP -------------------------------------------------------

alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB Oversized ICMP echo payload (possible ICMP tunnel)"; itype:8; dsize:>800; classtype:policy-violation; sid:1000020; rev:2; metadata:mitre_technique_id T1095;)

alert icmp $HOME_NET any -> $EXTERNAL_NET any (msg:"SOC-LAB High rate of outbound ICMP echo (possible ICMP tunnel)"; itype:8; threshold:type both,track by_src,count 50,seconds 60; classtype:policy-violation; sid:1000021; rev:2; metadata:mitre_technique_id T1095;)

# --- Protocol on an unexpected port --------------------------------------------

alert http $HOME_NET any -> $EXTERNAL_NET !$HTTP_PORTS (msg:"SOC-LAB Outbound HTTP on a non-standard port"; flow:established,to_server; classtype:policy-violation; sid:1000022; rev:2; metadata:mitre_technique_id T1571;)

# --- DNS reconnaissance ----------------------------------------------------------

alert dns any any -> $HOME_NET any (msg:"SOC-LAB DNS zone transfer (AXFR) request"; dns.rrtype:252; classtype:attempted-recon; sid:1000024; rev:2; metadata:mitre_technique_id T1590.002;)

# --- SMB lateral movement --------------------------------------------------------

# smb.share holds disk shares from TREE_CONNECT; pipe shares (IPC$) land in
# smb.named_pipe instead, so ADMIN$ / C$ access is matched here.
alert smb $EXTERNAL_NET any -> $HOME_NET any (msg:"SOC-LAB Hidden admin share accessed from outside the internal VLANs"; flow:established,to_server; smb.share; content:"$"; endswith; classtype:policy-violation; sid:1000025; rev:3; metadata:mitre_technique_id T1021.002;)

# smb.named_pipe is the IPC$ tree path, not the pipe opened, so the PsExec
# pipe is matched as its UTF-16LE name in the SMB2 CREATE request.
alert smb any any -> $HOME_NET any (msg:"SOC-LAB PsExec service pipe opened over SMB"; flow:established,to_server; content:"|FE|SMB"; offset:4; depth:4; content:"P|00|S|00|E|00|X|00|E|00|S|00|V|00|C|00|"; nocase; distance:0; classtype:attempted-admin; sid:1000026; rev:3; metadata:mitre_technique_id T1569.002;)

# --- Anonymisation / cleartext ---------------------------------------------------

alert tcp $HOME_NET any -> $EXTERNAL_NET [9001,9030,9050,9051,9150] (msg:"SOC-LAB Connection attempt to a common Tor port"; flags:S,12; classtype:policy-violation; sid:1000027; rev:3; metadata:mitre_technique_id T1090.003;)

alert ftp $HOME_NET any -> any any (msg:"SOC-LAB Cleartext FTP login"; flow:established,to_server; ftp.command; content:"USER"; classtype:policy-violation; sid:1000029; rev:2; metadata:mitre_technique_id T1040;)

alert tcp $HOME_NET any -> any 23 (msg:"SOC-LAB Cleartext Telnet connection attempt"; flags:S,12; classtype:policy-violation; sid:1000030; rev:3; metadata:mitre_technique_id T1040;)
